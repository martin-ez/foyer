# Copy this file to .dev.vars, which git ignores, to set the local backend's secrets and settings.

# The emails that may sign in to the local household, as a JSON list. The web checks' backend lets
# in members of the checks' own instead, listed in apps/client/web-checks/sign-in.ts.
HOUSEHOLD_MEMBERS='["you@example.com", "housemate@example.com"]'

# The Google OAuth client that people sign in with. Its authorized redirect URIs must include
# http://localhost:8787/auth/google/callback. Without it, only DEV_SIGN_IN signs people in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lets people sign in without Google, at http://localhost:8787/auth/dev?email=you@example.com.
DEV_SIGN_IN=1

# Expo's development server for the web app. The local backend forwards the app's pages to it, so
# that the web app and the backend share one address, http://localhost:8787.
WEB_APP_DEV_SERVER=http://localhost:8081
