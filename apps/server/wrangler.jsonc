{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foyer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  // The web app, exported by the deploy and preview scripts. Its files are served without running
  // the Worker. Every other request runs it, and it answers the app's pages after its own routes.
  "assets": { "directory": "../client/dist", "binding": "WEB_APP" },
  "observability": { "enabled": true },
  "secrets": { "required": ["HOUSEHOLD_MEMBERS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"] },
  // Off when deployed. The local backend turns them on in .dev.vars, which overrides them.
  "vars": { "DEV_SIGN_IN": "0", "WEB_APP_DEV_SERVER": "" },
  "durable_objects": {
    "bindings": [{ "name": "HOUSEHOLD", "class_name": "Household" }]
  },
  "exports": {
    "Household": { "type": "durable-object", "storage": "sqlite" }
  },
  "previews": {
    "observability": { "enabled": true },
    "durable_objects": {
      "bindings": [{ "name": "HOUSEHOLD", "class_name": "Household" }]
    }
  }
}
