{
  "name": "@foyer/client",
  "private": true,
  "main": "index",
  "scripts": {
    "start": "pnpm --filter @foyer/shared generate && expo start",
    "ios": "pnpm --filter @foyer/shared generate && expo run:ios",
    "web": "pnpm --filter @foyer/shared generate && expo start --web",
    "export-web": "expo export --platform web",
    "check-web": "playwright test",
    "check-ios-bundle": "pnpm --filter @foyer/shared generate && dir=\"$(mktemp -d)\" && trap 'rm -rf \"$dir\"' EXIT && expo export --platform ios --output-dir \"$dir\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "setup-skia-web public",
    "test": "vitest run",
    "update-golden-images": "UPDATE_GOLDEN_IMAGES=1 vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-web": "catalog:",
    "@foyer/shared": "workspace:*",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-skia": "^3.10.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/react": "~19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
