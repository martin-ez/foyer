# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Skia's web build, copied in by postinstall
public/canvaskit.wasm

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Drawings that differed from their golden images, written by the tests
test/golden-images/failures/

# What the web checks write: their screenshots, and Playwright's results
web-checks/screenshots/
web-checks/results/

# What the export checks write: the versions of the web app they serve, their screenshots, and
# Playwright's results
web-export-checks/versions/
web-export-checks/screenshots/
web-export-checks/results/

# A trace that `playwright trace open` extracted, to read from the command line
.playwright-cli/
