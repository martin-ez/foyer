{
  "name": "foyer",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "check": "pnpm typecheck && biome check . && pnpm --filter @foyer/shared lint-contracts",
    "typecheck": "pnpm generate && pnpm -r typecheck",
    "format": "biome check --write . && pnpm --filter @foyer/shared format-contracts",
    "generate": "pnpm --filter @foyer/shared generate",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "update-golden-images": "pnpm -r --if-present update-golden-images",
    "record-strokes": "node scripts/record-strokes.mjs",
    "sign-in-ipad": "node scripts/sign-in-ipad.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "qrcode-terminal": "0.12.0"
  }
}
