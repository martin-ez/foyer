{
  "name": "@foyer/shared",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gen/*": "./src/gen/*.ts",
    "./stroke-fixtures": "./test/fixtures/strokes/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "postinstall": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint-contracts": "buf lint && buf format --diff --exit-code",
    "format-contracts": "buf format --write",
    "check-breaking": "buf breaking --against '../../.git#branch=main,subdir=packages/shared'",
    "test": "pnpm run generate && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
